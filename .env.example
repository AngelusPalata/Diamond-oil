NODE_ENV=development
PORT=3000
# In production, point this at the host's mounted persistent volume.
# The directory must be outside the application folder.
DATABASE_DIR=../diamond-oil-private-data
# Use a private random value with at least 32 characters.
SESSION_SECRET=
SELLER_USERNAME=seller
# Used only to create the first seller account; use at least 12 characters.
SELLER_PASSWORD=
